{
  "cleanupPeriodDays": 30,
  "editorMode": "vim",
  "effortLevel": "high",
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "PYTHONPATH": "."
  },
{{- if eq .chezmoi.os "windows" }}
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"{{ .chezmoi.homeDir | replace "/" "\\\\" }}\\.claude\\hooks\\herdr-agent-state.ps1\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
{{- end }}
  "includeCoAuthoredBy": true,
  "model": "opus[1m]",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "MultiEdit",
      "Write",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(pyright:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(redis-cli:*)",
      "Bash(az:*)",
      "Bash(terraform:*)",
      "Bash(git:*)",
      "Bash(./tests/e2e/run_e2e_test.sh:*)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf /home)"
    ]
  },
  "statusLine": {
    "command": "bunx -y ccstatusline@latest",
    "padding": 0,
    "type": "command"
  },
  "voiceEnabled": false
}