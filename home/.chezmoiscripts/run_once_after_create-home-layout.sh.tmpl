#!/usr/bin/env bash
{{/*
    One-shot creation of the top-level home buckets listed in
    .chezmoidata/home_layout.yaml. Runs once (run_once_) after files are applied, so the
    dev-setup helper is already at ~/.local/bin. No-op on Windows (handled by
    the .ps1 variant; this .sh is also ignored there via .chezmoiignore).
*/}}
{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
set -euo pipefail

if [[ -f "$HOME/.local/bin/dev-setup" ]]; then
    bash "$HOME/.local/bin/dev-setup"
else
    # Fallback if the helper is missing: same source of truth (home_layout.yaml).
    DIRS=(
{{- template "home-layout-dirs" . }}
    )
    for rel in "${DIRS[@]}"; do mkdir -p "$HOME/$rel"; done
    echo "Home layout ready under $HOME"
fi
{{- else -}}
exit 0
{{- end }}
