#!/usr/bin/env bash
{{/*
    Bootstrap notes-sync on the Hermes host:
      1. Install the pinned obsidian-headless (ob) into its own npm prefix, and link ob
         into ~/.local/bin for interactive use.
      2. (Re)load the com.jared.notes-sync LaunchAgent.
    Re-runs whenever the pinned version, the plist, or the launcher changes (hashes below),
    and on every apply until it succeeds. Gated to the Hermes host via .chezmoiignore;
    darwin-guarded here too. The vault itself is set up once by hand: README, "Notes Sync".

    plist:    {{ include "Library/LaunchAgents/com.jared.notes-sync.plist.tmpl" | sha256sum }}
    launcher: {{ include "dot_local/bin/executable_notes-sync" | sha256sum }}
*/}}
{{ if eq .chezmoi.os "darwin" -}}
set -euo pipefail

# The obsidian-headless release the homelab obsidian-sync image is built from.
OB_VERSION="0.0.14"
PREFIX="$HOME/.local/share/obsidian-headless"
PACKAGE_JSON="$PREFIX/node_modules/obsidian-headless/package.json"
PLIST="$HOME/Library/LaunchAgents/com.jared.notes-sync.plist"
NODE_BIN="/opt/homebrew/opt/node/bin"

# 1. Install ob, unless the pinned version is already there.
installed=""
if [[ -f "$PACKAGE_JSON" ]]; then
    installed="$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$PACKAGE_JSON" | head -1)"
fi
if [[ "$installed" != "$OB_VERSION" ]]; then
    if [[ ! -x "$NODE_BIN/npm" ]]; then
        # Fail so chezmoi retries on the next apply once node is installed.
        echo "notes-sync: Homebrew node not found at $NODE_BIN; can't install ob." >&2
        exit 1
    fi
    echo "notes-sync: installing obsidian-headless@$OB_VERSION -> $PREFIX"
    PATH="$NODE_BIN:$PATH" npm install --prefix "$PREFIX" --loglevel=error \
        --no-audit --no-fund --no-update-notifier "obsidian-headless@$OB_VERSION"
fi
mkdir -p "$HOME/.local/bin"
ln -sfn "$PREFIX/node_modules/.bin/ob" "$HOME/.local/bin/ob"

# 2. (Re)load the LaunchAgent. launchd won't create the log directory itself.
mkdir -p "$HOME/.local/share/notes-sync"
if [[ -f "$PLIST" ]]; then
    uid="$(id -u)"
    launchctl bootout "gui/$uid/com.jared.notes-sync" 2>/dev/null || true
    launchctl bootstrap "gui/$uid" "$PLIST" 2>/dev/null ||
        launchctl load "$PLIST" 2>/dev/null || true
    echo "notes-sync: LaunchAgent (re)loaded"
fi
{{ else -}}
exit 0
{{ end -}}
