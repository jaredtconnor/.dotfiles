#!/usr/bin/env bash
{{/*
    Enable the obsidian-autopush timer on the notes backup host (identity.notes_backup_host;
    gated via .chezmoiignore, Linux-guarded here too). Re-runs when a unit or the script changes.

    service: {{ include "dot_config/systemd/user/obsidian-autopush.service" | sha256sum }}
    timer:   {{ include "dot_config/systemd/user/obsidian-autopush.timer" | sha256sum }}
    alert:   {{ include "dot_config/systemd/user/obsidian-autopush-alert.service" | sha256sum }}
    script:  {{ include "dot_local/bin/executable_obsidian-autopush" | sha256sum }}
*/}}
{{ if eq .chezmoi.os "linux" -}}
set -euo pipefail
# fleet-sync applies over SSH, where the user manager's runtime dir isn't always exported.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
systemctl --user daemon-reload
systemctl --user enable --now obsidian-autopush.timer
echo "obsidian-autopush: timer enabled"
{{ else -}}
exit 0
{{ end -}}
