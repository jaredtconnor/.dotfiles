{{- $zpriv := dict -}}
{{- $zpf := joinPath .chezmoi.homeDir ".dotfiles-private" "data.yaml" -}}
{{- if stat $zpf }}{{ $zpriv = (include $zpf | fromYaml) }}{{- end -}}
{{- $ompCmd := joinPath .chezmoi.homeDir ".local" "bin" "omp" -}}
{{- if eq .chezmoi.os "windows" }}{{ $ompCmd = joinPath .chezmoi.homeDir "AppData" "Local" "omp" "omp.exe" }}{{ end -}}
// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
    // ----------------------------------------------
    // Theme
    // ----------------------------------------------
    /* Duplicated key auto-commented: "agent": {
        "default_profile": "ask",
        "model_parameters": []
    }, */
    "icon_theme": "JetBrains New UI Icons (Light)",
    "agent_servers": {
        "cursor": {
            "type": "registry"
        },
        "codex-acp": {
            "default_config_options": {
                "model": "gpt-5.6-terra",
                "reasoning_effort": "high"
            },
            "type": "registry"
        },
        "claude-acp": {
            "type": "registry"
        },
        "amp-acp": {
            "type": "registry"
        },
        "omp": {
            "default_config_options": {
                "thinking": "high",
                "mode": "plan"
            },
            "type": "custom",
            "command": {{ $ompCmd | toJson }},
            "args": ["acp"],
            "env": {}
        }
    },
{{- /* Emitted in Zed's own layout and key order so Zed rewriting the file does not register as chezmoi drift. */}}
{{- $zconns := get $zpriv "zed_ssh_connections" | default (list) }}
{{- if not $zconns }}
    "ssh_connections": [],
{{- else }}
    "ssh_connections": [
{{- range $i, $c := $zconns }}{{ if $i }},{{ end }}
        {
            "host": {{ $c.host | toJson }},
{{- if hasKey $c "username" }}
            "username": {{ $c.username | toJson }},
{{- end }}
            "args": {{ get $c "args" | default (list) | toJson }},
{{- $projects := get $c "projects" | default (list) }}
{{- if not $projects }}
            "projects": []
{{- else }}
            "projects": [
{{- range $j, $p := $projects }}{{ if $j }},{{ end }}
                {
                    "paths": [
{{- range $k, $path := $p.paths }}{{ if $k }},{{ end }}
                        {{ $path | toJson }}
{{- end }}
                    ]
                }
{{- end }}
            ]
{{- end }}
        }
{{- end }}
    ],
{{- end }}
    "auto_update_extensions": {
        "html": false
    },
    "language_models": {
        "openai": {
            "api_url": "http://localhost:11434/v1"
        }
    },
    "theme": "Tokyo Night",
    "buffer_font_family": "Berkeley Mono",
    // ----------------------------------------------
    // Appearance
    // ----------------------------------------------
    "buffer_font_size": 12,
    "ui_font_size": 14,
    "relative_line_numbers": "enabled",
    "cursor_blink": true,
    "scrollbar": {
        "show": "system",
        "git_diff": true
    },
    "toolbar": {
        "breadcrumbs": true,
        "quick_actions": true
    },
    "project_panel": {
        "dock": "right",
        "git_status": true
    },
    "tab_bar": {
        "show": true
    },
    // ----------------------------------------------
    // Editor
    // ----------------------------------------------
    "always_treat_brackets_as_autoclosed": true,
    "tab_size": 4,
    "soft_wrap": "none",
    "autosave": "on_focus_change",
    // ----------------------------------------------
    // Coding
    // ----------------------------------------------
    "agent": {
        "default_profile": "write",
        "default_model": {
            "provider": "anthropic",
            "model": "claude-opus-4-5-latest"
        },
    },
    // ----------------------------------------------
    // Git
    // ----------------------------------------------
    "git": {
        "git_gutter": "tracked_files",
        "inline_blame": {
            "enabled": true
        }
    },
    // ----------------------------------------------
    // LSP
    // ----------------------------------------------
    "enable_language_server": true,
    "lsp": {},
    "format_on_save": "on",
    "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
        "edit_debounce_ms": 700,
        "scroll_debounce_ms": 50
    },
    "languages": {
        "TypeScript": {
            // Refer https://github.com/jellydn/ts-inlay-hints for how to setup for Neovim and VSCode
            "inlay_hints": {
                "enabled": true,
                "show_parameter_hints": false,
                "show_other_hints": true,
                "show_type_hints": true
            }
            // Uncomment below if use vtsls instead of typescript-language-server
            // "language_servers": ["!typescript-language-server", "vtsls", ".."]
        }
    },
    "language_overrides": {
        "C": {
            "format_on_save": "off",
            "preferred_line_length": 64,
            "soft_wrap": "preferred_line_length"
        },
        "JSON": {
            "tab_size": 4
        },
        "JavaScript": {
            "format_on_save": {
                "external": {
                    "command": "prettier",
                    "arguments": [
                        "--stdin-filepath",
                        "{buffer_path}"
                    ]
                }
            }
        },
        "Python": {
            "format_on_save": {
                "external": {
                    "command": "black",
                    "arguments": [
                        "-"
                    ]
                }
            }
        },
        "Astro": {},
        "Go": {},
        "C++": {},
        "Markdown": {},
        "CSS": {},
        "TypeScript": {
            "preferences": {
                "includeInlayParameterNameHints": "all",
                "includeInlayParameterNameHintsWhenArgumentMatchesName": true,
                "includeInlayFunctionParameterTypeHints": true,
                "includeInlayVariableTypeHints": true,
                "includeInlayVariableTypeHintsWhenTypeMatchesName": true,
                "includeInlayPropertyDeclarationTypeHints": true,
                "includeInlayFunctionLikeReturnTypeHints": true,
                "includeInlayEnumMemberValueHints": true,
            }
        },
        "TSX": {}
    },
    // ----------------------------------------------
    // Fomratters
    // ----------------------------------------------
    "formatter": "language_server",
    // ----------------------------------------------
    // Keymaps
    // ----------------------------------------------
    "base_keymap": "VSCode",
    "vim_mode": true,
    // ----------------------------------------------
    // Terminal
    // ----------------------------------------------
    "terminal": {
        "blinking": "off",
        "font_family": "JetBrainsMono Nerd Font Mono",
        "font_size": 12,
        "line_height": {
            "custom": 1.5
        },
        "button": true,
        "env": {
            "EDITOR": "zed --wait"
        }
    }
    // ----------------------------------------------
    // Utils
    // ----------------------------------------------
}
