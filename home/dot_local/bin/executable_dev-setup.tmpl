#!/usr/bin/env bash
#
# dev-setup — create the top-level home layout (idempotent).
#
# The directory list is NOT hardcoded here. It is generated at `chezmoi apply`
# from the single source of truth: home/.chezmoidata/home_layout.yaml. Edit that
# file, run `chezmoi apply`, then re-run `dev-setup` to materialize changes.
#
# Layout (TitleCase categories; macOS system folders left untouched):
#   ~/Code/      source repos — the ONLY repo root (managed by ghq); left flat.
#                Not on Windows: repos live flat in C:\Git (windows_code_root).
#   ~/Notes/     Obsidian vaults: Notes/work, Notes/personal
#   ~/Data/      databases, datasets, non-document data
#   ~/Tools/     local binaries and personal machine scripts
#   ~/Sandbox/   throwaway experiments
#   ~/Archives/  backups and long-term snapshots
#   ~/Work/      work hosts only: Issues/<KEY>, Projects, Scripts, References, ...
#   ~/Personal/  every other host: Projects, Scripts, References
#
# Repos go under ~/Code via ghq: `clone <url>` (or `ghq get <url>`), then jump
# with `repo` / `wt`. See ~/.config/gwq/config.toml and git config ghq.root.
# `home-tidy` sorts strays (Downloads, Desktop, ...) into these buckets.
set -euo pipefail

# Generated from home_layout.yaml. Relative to $HOME; nesting via `mkdir -p`.
DIRS=(
{{- template "home-layout-dirs" . }}
)

for rel in "${DIRS[@]}"; do
    d="$HOME/$rel"
    if [[ -d "$d" ]]; then
        printf '  exists   ~/%s\n' "$rel"
    else
        mkdir -p "$d"
        printf '  created  ~/%s\n' "$rel"
    fi
done

{{ if eq .chezmoi.os "windows" -}}
printf '\nHome layout ready. Repo root: %s (flat, short paths)\n' {{ .windows_code_root | quote }}
{{- else -}}
root="$(git config --get ghq.root 2>/dev/null || echo "$HOME/Code")"
printf '\nHome layout ready. Repo root: %s\n' "$root"
printf "Clone a repo:  clone <url|host/owner/repo>   |   Jump:  repo / wt\n"
{{- end }}
