[settings]
experimental = true
jobs = 4
plugin_autoupdate_last_check_duration = "7d"
verbose = false
{{ if eq .chezmoi.os "linux" }}python.compile = true
{{ end }}
[tools]
# Exact pins so every machine converges to the same toolchain.
# To bump: set the new version here, commit, then `chezmoi apply` (runs `mise install`).
go = "1.26.9"
node = "24.9.0"
python = "3.14.4"
deno = "2.5.2"
bun = "1.3.14"
direnv = "2.37.1"
rust = "1.90.0"
{{ if .workstation -}}
# Repo/worktree navigation — ghq (clones), gwq (worktrees), fzf (picker).
# Only on personal dev machines (see $workstationHostnames in .chezmoi.toml.tmpl).
# gwq has no mise registry/aqua entry, so build it via the Go backend.
# (gwq >= 0.1.1 needs Go >= 1.26; the Go backend auto-fetches it to build.)
ghq = "1.10.1"
fzf = "0.73.1"
"go:github.com/d-kuro/gwq/cmd/gwq" = "0.1.1"
{{ end -}}
