#!/bin/sh
# pre-push guard for repos whose remotes are shared with coworkers (every remote not on
# git.jcdev.io). Installed per repo into .git/hooks by `git shared-hooks install`; not a
# global hooksPath (see core.hooksPath note in ~/.config/git/config).
#
# Blocks: pushing archive/* or backup/* branches, pushing tags outside v*/planning-*/worker/*,
# and pushes touching more than 5 refs at once (e.g. --tags, --all, --mirror).
# Single-ref deletes are allowed. Bulk push on purpose: ALLOW_BULK_PUSH=1 git push ...
remote="$1"
url="$2"
case "$url" in
  *git.jcdev.io*) exit 0 ;;
esac

zero=0000000000000000000000000000000000000000
count=0
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  count=$((count + 1))
  [ "$local_sha" = "$zero" ] && continue   # delete
  case "$remote_ref" in
    refs/heads/archive/*|refs/heads/backup/*)
      echo "pre-push: blocked $remote_ref -> $remote (archive/backup branches stay local)" >&2; fail=1 ;;
    refs/tags/v[0-9]*|refs/tags/planning-*|refs/tags/worker/*) ;;
    refs/tags/*)
      echo "pre-push: blocked tag $remote_ref -> $remote (only v*, planning-*, worker/* tags are pushed)" >&2; fail=1 ;;
  esac
done
if [ "$count" -gt 5 ] && [ "${ALLOW_BULK_PUSH:-0}" != 1 ]; then
  echo "pre-push: blocked $count refs in one push to $remote (limit 5). Push refs by name, or set ALLOW_BULK_PUSH=1." >&2
  fail=1
fi
exit $fail
